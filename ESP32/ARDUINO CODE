
#include <TinyGPSPlus.h>

// =====================================
// HYDROVEST SMART LIFE JACKET
// ESP32 + GPS + GSM EMERGENCY SYSTEM
// =====================================

// GPS and GSM serial connections
HardwareSerial GPS(1);
HardwareSerial GSM(2);

TinyGPSPlus gps;

// ESP32 PIN CONFIGURATION
#define GPS_RX 16
#define GPS_TX 17

#define GSM_RX 18
#define GSM_TX 19

#define LED_PIN 25
#define BUZZER_PIN 26
#define SOS_BUTTON 27

// THREE EMERGENCY CONTACT NUMBERS
// Replace with your actual phone numbers.
const char* recipients[3] = {
  "+63XXXXXXXXXX",
  "+63XXXXXXXXXX",
  "+63XXXXXXXXXX"
};

// SYSTEM VARIABLES
bool sosActive = false;
bool lastButtonReading = HIGH;
bool stableButtonState = HIGH;

unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 50;

// =====================================
// GSM RESPONSE FUNCTION
// =====================================

String readGSMResponse(unsigned long timeout) {
  String response = "";
  unsigned long startTime = millis();

  while (millis() - startTime < timeout) {
    while (GSM.available()) {
      char c = GSM.read();
      response += c;
    }
  }

  Serial.println(response);
  return response;
}

// =====================================
// SEND SMS FUNCTION
// =====================================

bool sendSMS(const char* number, String message) {

  if (String(number).indexOf('X') >= 0) {
    Serial.println("Configure phone number first.");
    return false;
  }

  // Set SMS text mode
  GSM.println("AT+CMGF=1");

  String response = readGSMResponse(1500);

  if (response.indexOf("OK") < 0) {
    Serial.println("GSM text mode error.");
    return false;
  }

  // Enter recipient number
  GSM.print("AT+CMGS=\"");
  GSM.print(number);
  GSM.println("\"");

  response = readGSMResponse(3000);

  if (response.indexOf(">") < 0) {
    Serial.println("SMS prompt error.");
    return false;
  }

  // Send message
  GSM.print(message);
  GSM.write(26);

  response = readGSMResponse(20000);

  if (response.indexOf("+CMGS:") >= 0) {
    Serial.println("SMS successfully submitted.");
    return true;
  }

  Serial.println("SMS sending failed.");
  return false;
}

// =====================================
// GPS LOCATION FUNCTION
// =====================================

String getGPSLocation() {

  if (gps.location.isValid() &&
      gps.location.age() < 10000) {

    double latitude = gps.location.lat();
    double longitude = gps.location.lng();

    String mapsLink = "https://maps.google.com/?q=";
    mapsLink += String(latitude, 6);
    mapsLink += ",";
    mapsLink += String(longitude, 6);

    return mapsLink;
  }

  return "GPS location unavailable.";
}

// =====================================
// SEND SMS TO THREE RECIPIENTS
// =====================================

void sendToAllRecipients(String message) {

  for (int i = 0; i < 3; i++) {

    Serial.print("Sending SMS to recipient ");
    Serial.println(i + 1);

    sendSMS(recipients[i], message);

    delay(1000);
  }
}

// =====================================
// ACTIVATE SOS
// =====================================

void activateSOS() {

  sosActive = true;

  digitalWrite(LED_PIN, HIGH);
  digitalWrite(BUZZER_PIN, HIGH);

  String message = "HYDROVEST EMERGENCY ALERT!\n";
  message += "SOS ACTIVATED.\n";
  message += "Location: ";
  message += getGPSLocation();

  Serial.println(message);

  sendToAllRecipients(message);
}

// =====================================
// CANCEL SOS
// =====================================

void cancelSOS() {

  sosActive = false;

  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  String message = "HYDROVEST SOS CANCELLATION.\n";
  message += "The previous SOS alert has been cancelled.\n";
  message += "Location: ";
  message += getGPSLocation();

  Serial.println(message);

  sendToAllRecipients(message);
}

// =====================================
// SETUP
// =====================================

void setup() {

  Serial.begin(115200);

  // Start GPS
  GPS.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);

  // Start GSM
  GSM.begin(9600, SERIAL_8N1, GSM_RX, GSM_TX);

  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(SOS_BUTTON, INPUT_PULLUP);

  digitalWrite(LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  delay(3000);

  // Check GSM communication
  GSM.println("AT");
  readGSMResponse(1500);

  // Disable GSM command echo
  GSM.println("ATE0");
  readGSMResponse(1000);

  Serial.println("==============================");
  Serial.println(" HYDROVEST LIFE JACKET SYSTEM ");
  Serial.println(" SYSTEM READY ");
  Serial.println("==============================");

  Serial.println("Press SOS button to activate.");
  Serial.println("Press again to cancel SOS.");
}

// =====================================
// MAIN LOOP
// =====================================

void loop() {

  // Continuously read GPS information
  while (GPS.available()) {
    gps.encode(GPS.read());
  }

  // Read SOS button
  bool currentReading = digitalRead(SOS_BUTTON);

  if (currentReading != lastButtonReading) {
    lastDebounceTime = millis();
  }

  if (millis() - lastDebounceTime > debounceDelay) {

    if (currentReading != stableButtonState) {

      stableButtonState = currentReading;

      // Button pressed
      if (stableButtonState == LOW) {

        if (!sosActive) {
          activateSOS();
        } else {
          cancelSOS();
        }
      }
    }
  }

  lastButtonReading = currentReading;
}
